# IMAP access for tools/mail-fetch, which only reads: it never marks, moves or deletes mail.
# Copy this file to workspace/.env and fill it in. Environment variables override these values.
#
# Use a mailbox dedicated to your job search and an app password, never your main password.
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
# Outlook.com / Microsoft 365 do not accept app passwords over IMAP (OAuth2 is not supported yet).

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.name.jobs@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
