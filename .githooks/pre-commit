#!/bin/sh
# Blocks commits that would leak personal data into the public repo.
#
# 1. Nothing inside workspace/ (even if forced with `git add -f`).
# 2. No pattern from workspace/.private-patterns (one per line, extended regex,
#    case-insensitive; blank lines and lines starting with # are ignored) in added lines.
#
# Enable once per clone: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -q '^workspace/'; then
  echo "pre-commit: the commit includes files from workspace/. They are personal data; unstage them with:" >&2
  echo "  git restore --staged workspace/" >&2
  exit 1
fi

patterns="workspace/.private-patterns"
[ -f "$patterns" ] || exit 0

list=$(mktemp)
grep -v '^[[:space:]]*\(#\|$\)' "$patterns" > "$list"
if [ -s "$list" ]; then
  hits=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -i -E -f "$list")
  if [ -n "$hits" ]; then
    rm -f "$list"
    echo "pre-commit: the commit contains data matching workspace/.private-patterns:" >&2
    echo "$hits" | head -20 >&2
    exit 1
  fi
fi
rm -f "$list"
exit 0
